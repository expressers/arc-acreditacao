# Base de dados Postgres (no Render vem da base ligada ao serviço)
DATABASE_URL=postgres://postgres:dev@localhost:54329/arc

# Sessões e acessos
SESSION_SECRET=gerar-com-openssl-rand-hex-32
ADMIN_PASSWORD=palavra-passe-da-organizacao
DOOR_PIN=pin-numerico-da-entrada

# URL público (opcional; no Render usa-se RENDER_EXTERNAL_URL automaticamente)
# PUBLIC_URL=https://acreditacao.exemplo.ao

# Envio dos convites por email (SMTP). Sem isto a app funciona,
# mas os convites só podem ser partilhados por link.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_FROM=convites@dominio-verificado.ao
# SMTP_SENDER_NAME=Conferência ARC
# MAIL_RATE_PER_SEC=2

PORT=3107
