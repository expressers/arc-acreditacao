# Base de dados Postgres (no Render vem da base ligada ao serviço)
DATABASE_URL=postgres://postgres:dev@localhost:54329/arc

# Sessões e acessos
# Em produção (NODE_ENV=production) o servidor recusa arrancar sem estes valores.
SESSION_SECRET=gerar-com-openssl-rand-hex-32
ADMIN_PASSWORD=palavra-passe-da-organizacao-12-caracteres-ou-mais
DOOR_PIN=pin-da-entrada-6-digitos-ou-mais

# Proxy: ligar só se a Cloudflare estiver em modo proxy (nuvem laranja)
# TRUST_CLOUDFLARE=true

# Modo demonstração (dados fictícios no browser, sem backend). Desligado por omissão.
# VITE_DEMO=true

# URL público (opcional; no Render usa-se RENDER_EXTERNAL_URL automaticamente)
# PUBLIC_URL=https://acreditacao.exemplo.ao

# Envio dos convites por email (SMTP). Sem isto a app funciona,
# mas os convites só podem ser partilhados por link.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_FROM=convites@dominio-verificado.ao
# SMTP_SENDER_NAME=Conferência ARC
# MAIL_RATE_PER_SEC=2
# Cópia de todos os envios e endereço de resposta (separados por vírgula)
# MAIL_CC=cliente@dominio.ao
# Cópia de acompanhamento: enviada numa mensagem à parte (o convidado não vê nem recebe respostas)
# MAIL_BCC=cliente@dominio.ao
# MAIL_REPLY_TO=cliente@dominio.ao

PORT=3107
